MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
# Required for first-time setup. Set a unique secret of at least 24 characters.
ADMIN_SETUP_KEY=
# Required for employee self-signup. Share privately with employees; use at least 16 random characters.
EMPLOYEE_JOIN_CODE=
ALLOW_REGISTRATION=true
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
